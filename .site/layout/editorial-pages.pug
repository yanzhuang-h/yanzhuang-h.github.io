extends includes/layout.pug

block content
  if page.type === 'editorial-home'
    article.editorial-home
      section.editorial-opening(aria-label='开场')
        .editorial-greeting
          if config.editorial_opening
            p.editorial-message= config.editorial_opening
          else
            p.editorial-verse= config.subtitle
          p.editorial-byline= config.author
        .editorial-landscape(aria-hidden='true')
      .editorial-shelves
        section.editorial-selection(aria-labelledby='selected-title')
          .editorial-section-header
            h2#selected-title 文字
            a.editorial-more(href=url_for('language/')) 全部文字
              span(aria-hidden='true')  →
          each note, i in page.selected
            article.editorial-entry(class={ 'editorial-lead': i === 0 })
              time(datetime=note.iso)= note.iso.replace(/-/g, '.')
              h3
                a(href=url_for(note.url))= note.title
              if i === 0 && note.excerpt
                p= note.excerpt
        section.editorial-work-shelf(aria-labelledby='home-works')
          .editorial-section-header
            h2#home-works
              a(href=url_for('works/')) 作品
                span(aria-hidden='true') →
          if page.firstWork
            .editorial-work
              h3
                a(href=url_for(page.firstWork.url))= page.firstWork.title
              if page.firstWork.description
                p= page.firstWork.description
  else if page.type === 'editorial-language'
    article.editorial-language
      .editorial-catalogue-head
        h1= page.title
        p.editorial-count= page.count + ' 篇'
      nav.editorial-filters(aria-label='文字体裁')
        each genre in page.genreLinks
          a(href=url_for(genre.url) aria-current=genre.name === page.currentGenre ? 'page' : undefined)= genre.name
        a.editorial-topic-index(href=url_for('tags/')) 主题索引
      if page.topics.length
        nav.editorial-topics(aria-label='相关主题')
          span 相关主题
          each topic in page.topics
            a(href=url_for(topic.url))= topic.name
      each group in page.years
        section.editorial-year(aria-labelledby='year-' + group.year)
          h2(id='year-' + group.year)= group.year
          ul.editorial-titles
            each note in group.posts
              li
                time(datetime=note.iso)= note.shortDate
                a(href=url_for(note.url))= note.title
  else if page.type === 'editorial-works'
    article.editorial-works
      .editorial-catalogue-head
        h1 作品
      if page.works.length
        ul.editorial-works-list
          each work in page.works
            li.editorial-work
              h2
                a(href=url_for(work.url))= work.title
              if work.description
                p= work.description
      else
        p.editorial-empty 第一件作品正在准备中。
